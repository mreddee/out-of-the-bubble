# Copy to .env and fill in. Never commit .env.

# --- Google Cloud / BigQuery (sandbox) ---
GCP_PROJECT_ID=
# Path to a service-account JSON, or leave empty to use `gcloud auth application-default login`
GOOGLE_APPLICATION_CREDENTIALS=

# --- Databricks Free Edition ---
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=

# --- Hugging Face (dataset with serving Parquet files) ---
HF_TOKEN=
HF_DATASET_REPO=<username>/out-of-the-bubble-data

# --- Neon Postgres (feedback storage) ---
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# --- Last.fm API (non-commercial use) ---
LASTFM_API_KEY=

# --- MusicBrainz / ListenBrainz (no key; identify yourself) ---
MUSICBRAINZ_USER_AGENT=OutOfTheBubble/0.1 ( https://github.com/<username>/out-of-the-bubble )
